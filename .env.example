# Supabase -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key. Never put the service_role key in an EXPO_PUBLIC_ var.
EXPO_PUBLIC_SUPABASE_KEY=

# Only Google accounts on this domain get in. Keep it in sync with
# public.allowed_domains in the database, which is what actually enforces it.
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit
